# Copy to .env and fill in. NEVER commit .env (it holds secrets).
# Every variable the backend reads is listed here; a test keeps this file in sync.

# --- API keys (leave empty to disable that provider) -------------------------
SARVAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Database -------------------------------------------------------------------
# Folder of the Chroma database. A relative value is resolved against the repo
# root. Leave it as is unless you know why you are changing it.
# Careful: write ONLY the path on this line; a stray word glued on (for example
# "./chromadb_storecd backend") silently points the app at a new, empty database.
# Run `python scripts/doctor.py` if the database ever looks empty.
CHROMADB_PATH=./chromadb_store

# --- Retrieval --------------------------------------------------------------------
# chroma_default (English MiniLM, today's behaviour) or sentence_transformers.
EMBEDDING_BACKEND=chroma_default
# Only used with EMBEDDING_BACKEND=sentence_transformers. See docs/embedding-migration.md.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# hard (filter by the keyword router, today's behaviour) or none (never filter).
ROUTING_MODE=hard
